package server

import (
	"net/http"
	"strconv"

	"github.com/gin-gonic/gin"
)

// Student CRUD handlers

func (s *Server) getStudents(c *gin.Context) {
	search := c.Query("search")

	students, err := s.studentRepo.GetAll(c.Request.Context(), search)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to retrieve students",
		})
		return
	}

	c.JSON(http.StatusOK, students)
}

func (s *Server) getStudent(c *gin.Context) {
	id := c.Param("studentId")

	student, err := s.studentRepo.GetByID(c.Request.Context(), id)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{
			"error": "Student not found",
		})
		return
	}

	c.JSON(http.StatusOK, student)
}

func (s *Server) createStudent(c *gin.Context) {
	var req struct {
		Name        string `json:"name" binding:"required"`
		ClassID     string `json:"class_id" binding:"required"`
		Parent1ID   string `json:"parent_1_id" binding:"required"`
		Parent2ID   string `json:"parent_2_id"`
		BirthDate   string `json:"birth_date"`
		Phone       string `json:"phone"`
		PhotoURL    string `json:"photo_url"`
	}

	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid request format",
		})
		return
	}

	student, err := s.studentRepo.Create(c.Request.Context(), &req)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": err.Error(),
		})
		return
	}

	c.JSON(http.StatusCreated, student)
}

func (s *Server) updateStudent(c *gin.Context) {
	id := c.Param("studentId")

	var req struct {
		Name        string `json:"name" binding:"required"`
		ClassID     string `json:"class_id" binding:"required"`
		Parent1ID   string `json:"parent_1_id" binding:"required"`
		Parent2ID   string `json:"parent_2_id"`
		BirthDate   string `json:"birth_date"`
		Phone       string `json:"phone"`
		PhotoURL    string `json:"photo_url"`
	}

	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid request format",
		})
		return
	}

	student, err := s.studentRepo.Update(c.Request.Context(), id, &req)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, student)
}

func (s *Server) deleteStudent(c *gin.Context) {
	id := c.Param("studentId")

	err := s.studentRepo.Delete(c.Request.Context(), id)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"message": "Student deleted successfully",
	})
}

// Teacher CRUD handlers

func (s *Server) getTeachers(c *gin.Context) {
	search := c.Query("search")

	teachers, err := s.userRepo.GetTeachers(c.Request.Context(), search)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "Failed to retrieve teachers",
		})
		return
	}

	c.JSON(http.StatusOK, teachers)
}

func (s *Server) getTeacher(c *gin.Context) {
	id := c.Param("teacherId")

	teacher, err := s.userRepo.GetTeacherByID(c.Request.Context(), id)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{
			"error": "Teacher not found",
		})
		return
	}

	c.JSON(http.StatusOK, teacher)
}

func (s *Server) createTeacher(c *gin.Context) {
	var req struct {
		Name     string `json:"name" binding:"required"`
		Email    string `json:"email" binding:"required,email"`
		Phone    string `json:"phone"`
		Password string `json:"password" binding:"required,min=6"`
	}

	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid request format",
		})
		return
	}

	teacher, err := s.authService.RegisterTeacher(c.Request.Context(), &req)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": err.Error(),
		})
		return
	}

	c.JSON(http.StatusCreated, teacher)
}

func (s *Server) updateTeacher(c *gin.Context) {
	id := c.Param("teacherId")

	var req struct {
		Name  string `json:"name" binding:"required"`
		Email string `json:"email" binding:"required,email"`
		Phone string `json:"phone"`
	}

	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Invalid request format",
		})
		return
	}

	teacher, err := s.userRepo.UpdateTeacher(c.Request.Context(), id, &req)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, teacher)
}

func (s *Server) deleteTeacher(c *gin.Context) {
	id := c.Param("teacherId")

	err := s.userRepo.DeleteTeacher(c.Request.Context(), id)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"message": "Teacher deleted successfully",
	})
}

